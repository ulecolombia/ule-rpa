# =============================================================================
# ULE RPA SERVICE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# API Key for authentication (min 32 chars) - Generate with: openssl rand -hex 32
API_KEY=your-secret-api-key-minimum-32-characters-long-please-change

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ule:ule_password@localhost:5432/ule_rpa?schema=public"

# -----------------------------------------------------------------------------
# Redis (Queue Storage)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Enlace Operativo (Admin Account)
# -----------------------------------------------------------------------------
# Your admin account credentials for Enlace Operativo
ENLACE_BASE_URL=https://suaporte.com.co
ENLACE_ADMIN_DOC=1234567890
ENLACE_ADMIN_USER=your_enlace_username
ENLACE_ADMIN_PASS=your_enlace_password

# -----------------------------------------------------------------------------
# ULE API (Main Application)
# -----------------------------------------------------------------------------
# URL of the ULE Next.js application
ULE_API_URL=http://localhost:3000
# Webhook secret for verifying requests from ULE (min 16 chars)
ULE_WEBHOOK_SECRET=your-webhook-secret-minimum-16-chars

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Storage type: 'local' | 'vercel-blob' | 's3'
STORAGE_TYPE=local

# For local storage (if STORAGE_TYPE=local):
STORAGE_PATH=./uploads
STORAGE_BASE_URL=http://localhost:3001/files

# For Vercel Blob storage (if STORAGE_TYPE=vercel-blob):
# Get token from: https://vercel.com/dashboard/stores
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# For S3 storage (if STORAGE_TYPE=s3):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxxx...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ule-rpa-files

# -----------------------------------------------------------------------------
# Puppeteer (Browser Automation)
# -----------------------------------------------------------------------------
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
# Optional: Path to Chrome/Chromium executable
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# -----------------------------------------------------------------------------
# Queue Configuration
# -----------------------------------------------------------------------------
QUEUE_CONCURRENCY=1
QUEUE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Levels: debug, info, warn, error
LOG_LEVEL=debug
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Bancolombia PSE (FASE 6 - Pago Automático)
# -----------------------------------------------------------------------------
# Cuenta bancaria de ULE para recibir pagos PSE
BANCOLOMBIA_CUENTA_NUMERO=1234567890
BANCOLOMBIA_CUENTA_TIPO=Ahorros
BANCOLOMBIA_TITULAR_DOCUMENTO=1234567890

# -----------------------------------------------------------------------------
# Security / Encryption
# -----------------------------------------------------------------------------
# Optional: Encryption key for sensitive data (auto-generated if not provided)
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=your-encryption-key-here

# ========================================
# ENCRIPTACIÓN PSE - FASE 6.2
# ========================================
# Encriptación de códigos dinámicos PSE
# IMPORTANTE: Cambiar en producción por un string aleatorio de 32+ caracteres
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-random-secret-minimum-32-characters-long

# -----------------------------------------------------------------------------
# Test Credentials (for scripts in /scripts)
# -----------------------------------------------------------------------------
# SOI test account
TEST_SOI_DOCUMENTO=
TEST_SOI_PASSWORD=

# Mi Planilla test account
TEST_MIPLANILLA_DOCUMENTO=
TEST_MIPLANILLA_PASSWORD=

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# [ ] NODE_ENV=production
# [ ] API_KEY is strong and unique (32+ chars)
# [ ] ENLACE credentials are correct
# [ ] ULE_WEBHOOK_SECRET is shared with ULE app
# [ ] PUPPETEER_HEADLESS=true
# [ ] LOG_LEVEL=info or warn
# [ ] Database has backups enabled
# [ ] Redis has persistence enabled
# [ ] ENCRYPTION_KEY is set and stored securely
# [ ] ENCRYPTION_SECRET is set (min 32 chars) for PSE sessions
# =============================================================================
