# ==========================================
# Test Environment Variables
# Used for integration testing
# ==========================================

# Environment
NODE_ENV=test

# Application
PORT=3002
API_KEY=test-api-key-32-characters-minimum-length

# Database (use test database!)
DATABASE_URL=postgresql://user:password@localhost:5432/ule_rpa_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Enlace Operativo (Admin Account for Testing)
# IMPORTANT: Use test credentials, not production!
ENLACE_BASE_URL=https://suaporte.com.co
ENLACE_ADMIN_DOC=XXXXXXXXXX
ENLACE_ADMIN_USER=test_admin
ENLACE_ADMIN_PASS=test_password

# ULE API
ULE_API_URL=http://localhost:3000
ULE_WEBHOOK_SECRET=test-webhook-secret-16-chars

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./test-uploads
STORAGE_BASE_URL=http://localhost:3002/uploads

# Puppeteer Configuration
# Set to 'false' to watch tests run (useful for debugging)
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
PUPPETEER_EXECUTABLE_PATH=

# Logging
LOG_LEVEL=debug
LOG_DIR=./test-logs

# Queue Configuration
QUEUE_CONCURRENCY=1
QUEUE_MAX_RETRIES=2

# Test Data
# Document number of a user that exists in Enlace (for testing)
TEST_EXISTING_USER_DOC=1234567890
# Document number of a registered user (for liquidation tests)
TEST_REGISTERED_USER_DOC=1234567890

# Encryption
ENCRYPTION_KEY=test-encryption-key-32-characters

# ==========================================
# Test-Specific Settings
# ==========================================

# Skip certain tests
SKIP_SLOW_TESTS=false
SKIP_E2E_TESTS=false

# Test timeouts (milliseconds)
TEST_TIMEOUT_SHORT=30000
TEST_TIMEOUT_MEDIUM=60000
TEST_TIMEOUT_LONG=180000

# Screenshot settings for failed tests
SAVE_FAILED_SCREENSHOTS=true
SCREENSHOTS_DIR=./test-screenshots
