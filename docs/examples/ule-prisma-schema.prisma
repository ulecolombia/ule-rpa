// ============================================================================
// MODELO PAYMENT - NUEVO
// ============================================================================

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identificación del pago
  reference         String        @unique  // Referencia única para Wompi (ej: "PILA-user123-1234567890")
  amount            Int                    // Monto en centavos (COP) - Wompi usa centavos

  // Estado del pago
  status            PaymentStatus @default(PENDING)

  // Integración con Wompi
  wompiTransactionId String?               // ID de transacción de Wompi (ej: "12345-1234-...")
  wompiCheckoutId    String?               // ID de checkout de Wompi (opcional)

  // Integración con RPA Service
  rpaTaskId         String?                // ID de tarea en RPA Service (ej: "task-uuid")

  // Datos de PILA (almacenados como JSON)
  pilaData          Json                   // Estructura:
  // {
  //   periodo: "2026-02",
  //   ingresoBase: 1500000,
  //   ibc: 1500000,
  //   diasCotizados: 30,
  //   salud: 187500,
  //   pension: 240000,
  //   arl: 7830,
  //   nivelRiesgoARL: "I",
  //   total: 435330
  // }

  // Timestamps
  createdAt         DateTime      @default(now())   // Cuando se creó el pago
  confirmedAt       DateTime?                       // Cuando Wompi confirmó el pago
  updatedAt         DateTime      @updatedAt        // Última actualización

  // Índices para mejorar rendimiento de consultas
  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([rpaTaskId])
}

// ============================================================================
// ENUM PAYMENT STATUS - NUEVO
// ============================================================================

enum PaymentStatus {
  PENDING    // Pago creado, esperando confirmación de Wompi
  CONFIRMED  // Wompi confirmó el pago exitosamente
  FAILED     // Pago falló (error de banco, fondos insuficientes, etc.)
  REFUNDED   // Pago reembolsado al usuario
  CANCELLED  // Pago cancelado por el usuario o sistema
}

